# Variables de entorno necesarias para Railway
# Copia este archivo como .env y completa con tus valores

# MongoDB Atlas Connection String
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/volleyball?retryWrites=true&w=majority

# Puerto (Railway lo asigna automáticamente)
AUTH_MODE=strict
TRUST_PROXY=1

# Orígenes permitidos separados por coma (opcional).
# Si se omite, se permite el origen recibido.
ALLOWED_ORIGINS=https://volleyballmanager.up.railway.app

# Configuración JWT
JWT_SECRET=pon_aqui_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h
PORT=3000

# Variables para smoke check de seguridad en cloud
CHECK_BASE_URL=https://tu-app-en-la-nube.example.com
CHECK_USER=usuario_de_prueba
CHECK_PASS=password_de_prueba
